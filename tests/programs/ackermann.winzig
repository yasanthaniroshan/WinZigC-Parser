program ackermann:
var m, n : integer;
function ack(m, n : integer):integer;
begin
  if m = 0 then return (n + 1)
  else if n = 0 then return (ack(m - 1, 1))
  else return (ack(m - 1, ack(m, n - 1)));
end ack;
begin
  read(m);
  while m >= 0 do begin
    read(n);
    output(ack(m, n));
    read(m);
  end;
end ackermann.
