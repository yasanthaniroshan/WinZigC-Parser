program sum_of_squares:
# 1^2 + 2^2 + ... + n^2
var x : integer;
function f(n:integer):integer;
var i, s : integer;
begin
  s := 0; i := 1;
  while i <= n do begin
    s := s + i * i;
    i := i + 1;
  end;
  return (s);
end f;
begin
  read(x);
  while x > 0 do begin
    output(f(x));
    read(x);
  end;
end sum_of_squares.
