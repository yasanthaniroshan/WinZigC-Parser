program is_palindrome:
# 1 if the number is a palindrome
var x : integer;
function f(n:integer):integer;
var r, m : integer;
begin
  r := 0; m := n;
  while m > 0 do begin
    r := r * 10 + m mod 10;
    m := m / 10;
  end;
  if r = n then return (1) else return (0);
end f;
begin
  read(x);
  while x > 0 do begin
    output(f(x));
    read(x);
  end;
end is_palindrome.
