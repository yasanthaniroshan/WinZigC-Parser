program digit_sum:
# sum of decimal digits
var x : integer;
function f(n:integer):integer;
var s : integer;
begin
  s := 0;
  while n > 0 do begin
    s := s + n mod 10;
    n := n / 10;
  end;
  return (s);
end f;
begin
  read(x);
  while x > 0 do begin
    output(f(x));
    read(x);
  end;
end digit_sum.
