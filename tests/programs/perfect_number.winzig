program perfect_number:
# 1 if perfect number
var x : integer;
function f(n:integer):integer;
var i, s : integer;
begin
  s := 0; i := 1;
  while i < n do begin
    if n mod i = 0 then s := s + i;
    i := i + 1;
  end;
  if s = n then return (1) else return (0);
end f;
begin
  read(x);
  while x > 0 do begin
    output(f(x));
    read(x);
  end;
end perfect_number.
