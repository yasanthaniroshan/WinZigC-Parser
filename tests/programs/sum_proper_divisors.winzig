program sum_proper_divisors:
# sum of proper divisors
var x : integer;
function f(n:integer):integer;
var i, s : integer;
begin
  s := 0; i := 1;
  while i < n do begin
    if n mod i = 0 then s := s + i;
    i := i + 1;
  end;
  return (s);
end f;
begin
  read(x);
  while x > 0 do begin
    output(f(x));
    read(x);
  end;
end sum_proper_divisors.
