program grade_buckets:
# Map a 0..100 score to a grade code 4/3/2/1/0 using case ranges.
var s, g : integer;
begin
  read(s);
  while s > 0 do begin
    case s of
      90 .. 100: g := 4;
      80 .. 89:  g := 3;
      70 .. 79:  g := 2;
      60 .. 69:  g := 1;
    otherwise
      g := 0
    end;
    output(g);
    read(s);
  end;
end grade_buckets.
