program leap_year:
var y : integer;
function leap(y:integer):integer;
begin
  if y mod 400 = 0 then return (1);
  if y mod 100 = 0 then return (0);
  if y mod 4 = 0 then return (1);
  return (0);
end leap;
begin
  read(y);
  while y > 0 do begin
    output(leap(y));
    read(y);
  end;
end leap_year.
