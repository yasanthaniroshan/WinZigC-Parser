program count_divisors:
# number of divisors
var x : integer;
function f(n:integer):integer;
var i, c : integer;
begin
  c := 0; i := 1;
  while i <= n do begin
    if n mod i = 0 then c := c + 1;
    i := i + 1;
  end;
  return (c);
end f;
begin
  read(x);
  while x > 0 do begin
    output(f(x));
    read(x);
  end;
end count_divisors.
